diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -717,17 +717,31 @@ extern unsigned char iso_font[256 * 16];
 #define FBCON_FG        0xffffffffu
 #define FBCON_BG        0xff000000u
 
-static volatile uint32_t *fbcon_base;
-static uint32_t fbcon_width, fbcon_height, fbcon_stride;
+volatile uint8_t *fbcon_base;
+uint32_t fbcon_width, fbcon_height, fbcon_stride, fbcon_bypp = 4;
+/* Command-mode panels (Pixel 3a XL bonito, SDM670 SDE_CTL0_START 0x0ae0201c) */
+volatile uint32_t *fbcon_kickoff = NULL;
+
+static inline void
+fbcon_px(uint32_t x, uint32_t y, uint32_t c)
+{
+	volatile uint8_t *p = fbcon_base + y * fbcon_stride + x * fbcon_bypp;
+	if (fbcon_bypp == 4) {
+		*(volatile uint32_t *)p = c;
+	} else {
+		p[0] = (uint8_t)c;
+		p[1] = (uint8_t)(c >> 8);
+		p[2] = (uint8_t)(c >> 16);
+	}
+}
+
 static uint32_t fbcon_cols, fbcon_rows, fbcon_col, fbcon_row;
 
 static void
 fbcon_clear_row(uint32_t row)
 {
 	for (uint32_t y = row * 16 * FBCON_SCALE; y < (row + 1) * 16 * FBCON_SCALE; y++) {
-		volatile uint32_t *line = fbcon_base + y * (fbcon_stride / 4);
 		for (uint32_t x = 0; x < fbcon_width; x++) {
-			line[x] = FBCON_BG;
+			fbcon_px(x, y, FBCON_BG);
 		}
 	}
 }
@@ -739,6 +753,10 @@ fbcon_newline(void)
 	fbcon_row = (fbcon_row + 1) % fbcon_rows;
 	fbcon_clear_row(fbcon_row);
 	fbcon_clear_row((fbcon_row + 1) % fbcon_rows);
+	if (fbcon_kickoff != NULL) {
+		__builtin_arm_dsb(DSB_SY);
+		*fbcon_kickoff = 1;
+	}
 }
 
 static void
@@ -750,6 +768,10 @@ fbcon_init(void)
 	for (uint32_t r = 0; r < fbcon_rows; r++) {
 		fbcon_clear_row(r);
 	}
+	if (fbcon_kickoff != NULL) {
+		__builtin_arm_dsb(DSB_SY);
+		*fbcon_kickoff = 1;
+	}
 }
 
 static unsigned int
@@ -776,12 +798,12 @@ fbcon_transmit_data(uint8_t c)
 	uint32_t x0 = fbcon_col * 8 * FBCON_SCALE, y0 = fbcon_row * 16 * FBCON_SCALE;
 	for (uint32_t gy = 0; gy < 16; gy++) {
 		for (uint32_t sy = 0; sy < FBCON_SCALE; sy++) {
-			volatile uint32_t *line = fbcon_base + (y0 + gy * FBCON_SCALE + sy) * (fbcon_stride / 4) + x0;
+			uint32_t y = y0 + gy * FBCON_SCALE + sy;
 			for (uint32_t gx = 0; gx < 8; gx++) {
 				uint32_t px = (glyph[gy] & (1u << gx)) ? FBCON_FG : FBCON_BG;
 				for (uint32_t sx = 0; sx < FBCON_SCALE; sx++) {
-					line[gx * FBCON_SCALE + sx] = px;
+					fbcon_px(x0 + gx * FBCON_SCALE + sx, y, px);
 				}
 			}
 		}
 	}
 	fbcon_col++;
+	if (fbcon_kickoff != NULL && (c == '\n' || fbcon_col == fbcon_cols - 1)) {
+		__builtin_arm_dsb(DSB_SY);
+		*fbcon_kickoff = 1;
+	}
 }
 
 static unsigned int
@@ -831,11 +853,22 @@ fbcon_probe(void)
 	if (SecureDTGetProperty(entry, "stride", (void const **)&val, &size) == kSuccess) {
 		fbcon_stride = *val;
 	}
-	if (!fbcon_width || !fbcon_height || fbcon_stride < fbcon_width * 4) {
+	if (SecureDTGetProperty(entry, "bits-per-pixel", (void const **)&val, &size) == kSuccess &&
+	    (*val == 24 || *val == 32)) {
+		fbcon_bypp = *val / 8;
+	}
+	if (!fbcon_width || !fbcon_height || fbcon_stride < fbcon_width * fbcon_bypp) {
 		return;
 	}
 	sweet_early_mark(17, "fbcon config read; mapping");
-	fbcon_base = (volatile uint32_t *)ml_io_map_wcomb(reg[0], reg[1]);
+	uint64_t const *kick;
+	if (SecureDTGetProperty(entry, "kickoff-reg", (void const **)&kick, &size) == kSuccess && size == 8) {
+		vm_offset_t page = ml_io_map(trunc_page_64(*kick), PAGE_SIZE);
+		if (page != 0) {
+			fbcon_kickoff = (volatile uint32_t *)(page + (*kick & PAGE_MASK));
+		}
+	}
+	fbcon_base = (volatile uint8_t *)ml_io_map_wcomb(reg[0], reg[1]);
 	fbcon_init();
 	register_serial_functions(&fbcon_fns);
